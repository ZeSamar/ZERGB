<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="356" Height="648" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="True"
        Title="ZERGB" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="Foreground" Value="#8A93A8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1B2130"/>
                <Setter Property="Foreground" Value="#E8ECF5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#B9C2D6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" CornerRadius="9" Background="#151A26" BorderBrush="#242B3C" BorderThickness="1" Padding="11,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1C2331"/>
                <Setter Property="Foreground" Value="#E8ECF5"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#17325E"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#3D6FD6"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AppleToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#3A3D43"/>
              <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform>
                  <TranslateTransform x:Name="ThumbX"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#34C759"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border CornerRadius="18" Background="#0E1016" BorderBrush="#232A3B" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>

      <!-- заголовок -->
      <Grid Grid.Row="0" x:Name="Header" Margin="18,12,12,0" Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#3DDC84" Margin="0,0,9,0"/>
          <TextBlock Text="ZERGB" Foreground="#C9D1E0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="PowerBtn" Content="⏻" Style="{StaticResource IconBtn}" ToolTip="Включить/выключить подсветку"/>
          <TextBlock Text="Каналы" Foreground="#8A93A8" FontSize="10" VerticalAlignment="Center" Margin="6,0,3,0"/>
          <ToggleButton x:Name="ChanFixBtn" Style="{StaticResource AppleToggle}" ToolTip="Поправка каналов (R→B→G)" Margin="0,0,0,0"/>
          <TextBlock Text="Поверх" Foreground="#8A93A8" FontSize="10" VerticalAlignment="Center" Margin="6,0,3,0"/>
          <ToggleButton x:Name="PinBtn" Style="{StaticResource AppleToggle}" ToolTip="Поверх всех окон"/>
          <Button x:Name="MinBtn" Content="—" Style="{StaticResource IconBtn}" ToolTip="Свернуть в трей"/>
          <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource IconBtn}" ToolTip="Закрыть"/>
        </StackPanel>
      </Grid>

      <!-- цветовой круг -->
      <Canvas x:Name="WheelHost" Grid.Row="1" Width="244" Height="244" Margin="0,6,0,0" HorizontalAlignment="Center" Background="Transparent">
        <Image x:Name="WheelImg" Width="244" Height="244" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Ellipse x:Name="WheelRing" Width="20" Height="20" Stroke="#FFFFFF" StrokeThickness="2.5" Fill="#00000000" IsHitTestVisible="False"/>
        <Ellipse x:Name="WheelCore" Width="16" Height="16" Stroke="#FFFFFF" StrokeThickness="2" Fill="#00000000" IsHitTestVisible="False"/>
      </Canvas>

      <!-- текущий цвет -->
      <Grid Grid.Row="2" Margin="22,8,22,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="Swatch" Width="20" Height="20" CornerRadius="10" Background="#FFCC00"/>
          <TextBlock x:Name="HexText" Text="#FFCC00" Foreground="#E8ECF5" FontSize="13" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="RgbText" Text="255 · 255 · 0" HorizontalAlignment="Right" Foreground="#6E7A90" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
      </Grid>

      <!-- яркость -->
      <StackPanel Grid.Row="3" Margin="22,16,22,0">
        <Grid>
          <TextBlock Text="Яркость" Foreground="#8A93A8" FontSize="11"/>
          <TextBlock x:Name="BriText" Text="100%" HorizontalAlignment="Right" Foreground="#C9D1E0" FontSize="11"/>
        </Grid>
        <Grid x:Name="BriHost" Height="22" Margin="0,7,0,0" Background="Transparent">
          <Border Height="6" CornerRadius="3" Background="#1B2130" VerticalAlignment="Center"/>
          <Border x:Name="BriFill" Height="6" CornerRadius="3" Background="#4C8DFF" VerticalAlignment="Center" HorizontalAlignment="Left" Width="240"/>
          <Ellipse x:Name="BriThumb" Width="14" Height="14" Fill="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"/>
        </Grid>
      </StackPanel>


      <!-- эффекты -->
      <StackPanel Grid.Row="4" Margin="22,12,22,0">
        <Grid>
          <TextBlock Text="Эффект" Foreground="#8A93A8" FontSize="11" VerticalAlignment="Center"/>
          <Slider x:Name="SpeedSlider" Width="150" Minimum="0" Maximum="9" TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer Height="106" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"><UniformGrid x:Name="ModePanel" Columns="4"/></ScrollViewer>
      </StackPanel>

      <!-- пресеты -->
      <StackPanel Grid.Row="5" Margin="22,10,22,0">
        <Grid>
          <TextBlock Text="Пресеты" Foreground="#8A93A8" FontSize="11"/>
          <TextBlock Text="ПКМ — сохранить" HorizontalAlignment="Right" Foreground="#4E5A70" FontSize="10"/>
        </Grid>
        <UniformGrid x:Name="PresetPanel" Rows="1" Margin="0,8,0,0" Height="34"/>
      </StackPanel>

      <!-- низ -->
      <TextBlock x:Name="StatusText" Grid.Row="8" Text="RGB Fusion: подключение…" Margin="22,0,22,10"
                 Foreground="#5C677D" FontSize="10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border>
</Window>